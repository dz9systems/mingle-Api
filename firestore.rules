rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isHostOf(eventDoc) {
      return isSignedIn()
        && eventDoc != null
        && (
          eventDoc.data.hostId == request.auth.uid
          || ('hostIds' in eventDoc.data
            && eventDoc.data.hostIds.hasAny([request.auth.uid]))
        );
    }
    function isPublishedStatus(data) {
      return data != null && (!('status' in data) || data.status == 'published');
    }
    function eventDoc(slug) {
      return get(/databases/$(database)/documents/events/$(slug));
    }
    function isPublishedEvent(slug) {
      return isPublishedStatus(eventDoc(slug).data);
    }
    function canReadEvent(slug) {
      return isPublishedEvent(slug) || isHostOf(eventDoc(slug));
    }

    function isJoiningAsCohost() {
      return isSignedIn()
        && resource.data.cohostToken is string
        && resource.data.cohostToken.size() > 0
        && request.resource.data.cohostToken == resource.data.cohostToken
        && request.resource.data.hostId == resource.data.hostId
        && !isHostOf(resource)
        && request.resource.data.hostIds.hasAll(
          ('hostIds' in resource.data) ? resource.data.hostIds : [resource.data.hostId]
        )
        && request.resource.data.hostIds.hasAny([request.auth.uid])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hostIds', 'hosts']);
    }

    match /events/{slug} {
      allow read: if isPublishedStatus(resource.data) || isHostOf(resource);

      allow create: if isSignedIn()
                     && request.resource.data.hostId == request.auth.uid
                     && request.auth.uid in request.resource.data.hostIds
                     && (!('status' in request.resource.data) || request.resource.data.status in ['draft', 'published']);

      allow update: if isHostOf(resource) || isJoiningAsCohost();
      allow delete: if isSignedIn() && resource.data.hostId == request.auth.uid;

      match /rsvps/{uid} {
        allow read: if canReadEvent(slug);
        allow create, update: if isPublishedEvent(slug)
          && ((isSignedIn() && request.auth.uid == uid) || uid.matches('^guest-.+'));
        allow delete: if (isSignedIn() && request.auth.uid == uid)
                      || uid.matches('^guest-.+')
                      || isHostOf(eventDoc(slug));
      }

      match /potluck/{itemId} {
        allow read: if canReadEvent(slug);
        allow create, update: if isHostOf(eventDoc(slug)) || isPublishedEvent(slug);
        allow delete: if isHostOf(eventDoc(slug));
      }

      match /songs/{songId} {
        allow read: if canReadEvent(slug);
        allow create, update: if isHostOf(eventDoc(slug)) || isPublishedEvent(slug);
        allow delete: if isHostOf(eventDoc(slug));
      }

      match /teamAssignments/{uid} {
        allow read: if canReadEvent(slug);
        allow create, update: if isPublishedEvent(slug)
          && (
            (isSignedIn() && request.auth.uid == uid)
            || uid.matches('^guest-.+')
            || isHostOf(eventDoc(slug))
          );
        allow delete: if (isSignedIn() && request.auth.uid == uid)
                      || uid.matches('^guest-.+')
                      || isHostOf(eventDoc(slug));
      }

      // Host-readable send history for the communication UI. Writes are backend-only.
      match /messageLog/{logId} {
        allow read: if isHostOf(eventDoc(slug));
        allow write: if false;
      }
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      // Clients own their profile but cannot set/change `admin` (Admin SDK / set-admin script only).
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.get('admin', false) == false;
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['admin']);
      allow delete: if isSignedIn() && request.auth.uid == userId;

      match /hostedEvents/{slug} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      // Legacy name — kept briefly so sign-in migration can move docs to hostedEvents
      match /eventMemberships/{slug} {
        allow read, delete: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /eventBackups/{slug} {
      allow read: if isSignedIn() && resource.data.deletedBy == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.deletedBy == request.auth.uid
        && request.resource.data.slug == slug;
      allow delete: if isSignedIn() && resource.data.deletedBy == request.auth.uid;
      allow update: if false;

      match /{subcollection}/{docId} {
        allow read, create, delete: if isSignedIn()
          && get(/databases/$(database)/documents/eventBackups/$(slug)).data.deletedBy == request.auth.uid;
        allow update: if false;
      }
    }

    match /rateLimits/{uid}         { allow read, write: if false; }
    match /hostIntegrations/{uid} { allow read, write: if false; }
    match /calendarEvents/{slug}    { allow read, write: if false; }
  }
}

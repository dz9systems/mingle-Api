rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isHostOf(eventDoc) {
      return isSignedIn()
        && eventDoc != null
        && (
          eventDoc.data.hostId == request.auth.uid
          || ('hostIds' in eventDoc.data
            && eventDoc.data.hostIds.hasAny([request.auth.uid]))
        );
    }
    function isPublishedStatus(data) {
      return data != null && (!('status' in data) || data.status == 'published');
    }
    function eventDoc(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId));
    }
    function isPublishedEvent(eventId) {
      return isPublishedStatus(eventDoc(eventId).data);
    }
    function canReadEvent(eventId) {
      return isPublishedEvent(eventId) || isHostOf(eventDoc(eventId));
    }

    function isJoiningAsCohost() {
      return isSignedIn()
        && resource.data.cohostToken is string
        && resource.data.cohostToken.size() > 0
        && request.resource.data.cohostToken == resource.data.cohostToken
        && request.resource.data.hostId == resource.data.hostId
        && !isHostOf(resource)
        && request.resource.data.hostIds.hasAll(
          ('hostIds' in resource.data) ? resource.data.hostIds : [resource.data.hostId]
        )
        && request.resource.data.hostIds.hasAny([request.auth.uid])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hostIds', 'hosts']);
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /hostedEvents/{slug} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /eventMemberships/{slug} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /eventBackups/{slug} {
      allow read: if request.auth != null && resource.data.deletedBy == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.deletedBy == request.auth.uid
        && request.resource.data.slug == slug;
      allow delete: if request.auth != null && resource.data.deletedBy == request.auth.uid;
      allow update: if false;

      match /{subcollection}/{docId} {
        allow read, create, delete: if request.auth != null
          && get(/databases/$(database)/documents/eventBackups/$(slug)).data.deletedBy == request.auth.uid;
        allow update: if false;
      }
    }

    match /events/{eventId} {
      allow read: if isPublishedStatus(resource.data) || isHostOf(resource);
      allow create: if request.auth != null
        && request.resource.data.hostId == request.auth.uid
        && (!('status' in request.resource.data) || request.resource.data.status in ['draft', 'published']);
      allow update: if isHostOf(resource) || isJoiningAsCohost();
      allow delete: if isSignedIn() && resource.data.hostId == request.auth.uid;

      match /rsvps/{uid} {
        allow read: if canReadEvent(eventId);
        allow create, update: if isPublishedEvent(eventId)
          && ((isSignedIn() && request.auth.uid == uid) || uid.matches('^guest-.+'));
        allow delete: if (isSignedIn() && request.auth.uid == uid)
                      || uid.matches('^guest-.+')
                      || isHostOf(eventDoc(eventId));
      }

      match /potluck/{itemId} {
        allow read: if canReadEvent(eventId);
        allow create, update: if isHostOf(eventDoc(eventId)) || isPublishedEvent(eventId);
        allow delete: if isHostOf(eventDoc(eventId));
      }

      match /songs/{songId} {
        allow read: if canReadEvent(eventId);
        allow create, update: if isHostOf(eventDoc(eventId)) || isPublishedEvent(eventId);
        allow delete: if isHostOf(eventDoc(eventId));
      }

      match /teamAssignments/{uid} {
        allow read: if canReadEvent(eventId);
        allow create, update: if isPublishedEvent(eventId)
          && ((isSignedIn() && request.auth.uid == uid) || uid.matches('^guest-.+'));
        allow delete: if (isSignedIn() && request.auth.uid == uid)
                      || uid.matches('^guest-.+')
                      || isHostOf(eventDoc(eventId));
      }

      // Host-readable send history for the communication UI. Writes are backend-only.
      match /messageLog/{logId} {
        allow read: if isHostOf(eventDoc(eventId));
        allow write: if false;
      }
    }

    match /rateLimits/{uid}         { allow read, write: if false; }
    match /hostIntegrations/{uid} { allow read, write: if false; }
    match /calendarEvents/{slug}    { allow read, write: if false; }
  }
}
